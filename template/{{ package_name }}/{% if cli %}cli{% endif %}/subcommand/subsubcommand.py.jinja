from datetime import datetime

import click

from {{ package_name }}.app_context import AppContext


@click.command()
@click.argument("some_argument", type=str)
@click.option(
    "--some-option",
    type=click.DateTime(formats=["%Y-%m-%d"]),
    help="Some option",
)
@click.pass_context
def subsubcommand(
    ctx: click.Context,
    some_option: datetime | None = None,
    some_argument: str | None = "default_value",
) -> None:
    """Hey dawg I heard you like commands inside commands"""
    try:
        app_context: AppContext = ctx.obj
        click.echo(
            f"subcommand subsub: {app_context.app_config.app_name} {some_option} {some_argument}"
        )
    except Exception as e:  # noqa: BLE001
        click.echo(f"CLI Error: {e!s}")
        ctx.exit(1)
